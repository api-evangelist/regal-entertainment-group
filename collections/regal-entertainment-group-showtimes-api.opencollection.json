{
  "opencollection": "1.0.0",
  "info": {
    "name": "Regal Cinema Loyalty Showtimes API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Ocp-Apim-Subscription-Key",
      "value": "{{Ocp-Apim-Subscription-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Showtimes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Showtimes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.regmovies.com/v1/showtimes",
            "params": [
              {
                "name": "movieId",
                "value": "",
                "type": "query",
                "description": "Filter by movie ID"
              },
              {
                "name": "theatreId",
                "value": "",
                "type": "query",
                "description": "Filter by theatre ID"
              },
              {
                "name": "date",
                "value": "",
                "type": "query",
                "description": "Date in YYYY-MM-DD format (defaults to today)"
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Filter by screening format (IMAX, 4DX, RPX, 2D, 3D)"
              }
            ]
          },
          "docs": "Retrieve showtimes filtered by movie, theatre, or date."
        }
      ]
    }
  ],
  "bundled": true
}