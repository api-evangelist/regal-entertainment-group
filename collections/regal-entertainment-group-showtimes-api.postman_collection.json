    "_postman_id": "df951e47-7b56-45f8-87bf-02f167d77c28",
    "name": "Regal Cinema Loyalty Showtimes API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Regal Cinema API provides programmatic access to movie showtimes, theatre information, ticketing, and loyalty reward features for Regal Entertainment Group's theatre circuit. Available via the Regal API Management developer portal at developer.regmovies.com, powered by Azure API Management. Partners and developers must register and obtain an API key to access the endpoints.\n\nContact Support:\n Name: Regal API Manager\n Email: apimanager@regalcinemas.com",
      "type": "text/plain"
    }
  }
